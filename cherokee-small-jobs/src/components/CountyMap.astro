---
/**
 * A sketch of Cherokee County along I-575, not to scale: Ball Ground to Towne
 * Lake down the interstate, with the towns off it to either side.
 */
---

<svg class="map" viewBox="0 0 360 420" role="img" aria-label="Sketch map of Cherokee County along I-575: Ball Ground in the north, then Canton, Holly Springs, Woodstock and Towne Lake to the south, with Waleska and Sixes to the west and Free Home and Hickory Flat to the east">
  <path class="county" d="M40 30 L320 22 L338 120 L330 400 L28 404 L22 200 Z" />
  <text class="cty" x="52" y="54">CHEROKEE COUNTY</text>
  <path class="spur" d="M180 170 L78 150 M180 170 L292 186 M180 268 L292 300 M180 268 L78 290" />
  <path class="road" d="M180 60 L180 390" />
  <path class="road-c" d="M180 60 L180 390" />
  <g transform="translate(206 100)">
    <path d="M-17 -16 h34 v12 c0 13 -8 20 -17 24 c-9 -4 -17 -11 -17 -24 z" fill="#141111" />
    <path d="M-17 -16 h34 v8 h-34 z" fill="#b3121b" />
    <text class="shield-t" x="0" y="10" text-anchor="middle">575</text>
  </g>
  <circle class="stop" cx="180" cy="70" r="8" /><text x="160" y="75" text-anchor="end">Ball Ground</text>
  <circle class="stop" cx="180" cy="170" r="10" /><text x="198" y="160">Canton</text>
  <circle class="stop" cx="180" cy="230" r="8" /><text x="198" y="235">Holly Springs</text>
  <circle class="stop" cx="180" cy="320" r="8" /><text x="198" y="325">Woodstock</text>
  <circle class="stop" cx="180" cy="378" r="8" /><text x="198" y="383">Towne Lake</text>
  <circle class="side" cx="78" cy="150" r="6" /><text x="78" y="135" text-anchor="middle">Waleska</text>
  <circle class="side" cx="292" cy="186" r="6" /><text x="292" y="210" text-anchor="middle">Free Home</text>
  <circle class="side" cx="292" cy="300" r="6" /><text x="290" y="285" text-anchor="middle">Hickory Flat</text>
  <circle class="side" cx="78" cy="290" r="6" /><text x="78" y="314" text-anchor="middle">Sixes</text>
</svg>
