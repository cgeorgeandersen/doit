---
/**
 * The round shop badge: name on the top arc, trade and county on the bottom,
 * a wrench in the red center. `id` keeps the arc paths unique when the badge
 * appears twice on a page (header and footer).
 */
import { ICONS } from '../lib/icons';

interface Props {
  id: string;
  class?: string;
}
const { id, class: cls } = Astro.props;
---

<svg class:list={['badge', cls]} viewBox="0 0 200 200" role="img" aria-label="Cherokee Small Jobs, handyman, Cherokee County, Georgia">
  <defs>
    <path id={`${id}-top`} d="M 31 100 A 69 69 0 0 1 169 100" />
    <path id={`${id}-bot`} d="M 21 100 A 79 79 0 0 0 179 100" />
  </defs>
  <circle cx="100" cy="100" r="99" fill="#ffffff" />
  <circle cx="100" cy="100" r="95" fill="#141111" />
  <circle cx="100" cy="100" r="89" fill="none" stroke="#ffffff" stroke-width="1.5" />
  <circle cx="100" cy="100" r="54" fill="#b3121b" stroke="#ffffff" stroke-width="3" />
  <text class="b-top"><textPath href={`#${id}-top`} startOffset="50%" text-anchor="middle">CHEROKEE SMALL JOBS</textPath></text>
  <text class="b-bot"><textPath href={`#${id}-bot`} startOffset="50%" text-anchor="middle">HANDYMAN · CHEROKEE CO. GA</textPath></text>
  <path d="M27 95.5l1.4 2.9 3.2.5-2.3 2.2.5 3.2-2.8-1.5-2.8 1.5.5-3.2-2.3-2.2 3.2-.5z" fill="#ff5a62" />
  <path d="M173 95.5l1.4 2.9 3.2.5-2.3 2.2.5 3.2-2.8-1.5-2.8 1.5.5-3.2-2.3-2.2 3.2-.5z" fill="#ff5a62" />
  <svg x="74" y="74" width="52" height="52" viewBox="0 0 24 24" fill="none" stroke="#ffffff" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" set:html={ICONS.wrench} />
</svg>
