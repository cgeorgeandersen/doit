{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "astro",
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "trailingSlash": false,
  "ignoreCommand": "git diff --quiet HEAD^ HEAD -- .",
  "redirects": [
    {
      "source": "/frameworks/make-ai-boring",
      "destination": "/frameworks/ai-should-be-boring",
      "permanent": true
    },
    {
      "source": "/og/frameworks/make-ai-boring.png",
      "destination": "/og/frameworks/ai-should-be-boring.png",
      "permanent": true
    },
    {
      "source": "/writing/cyborgs-centaurs-and-reverse-centaurs",
      "destination": "/writing/passengers-centaurs-and-reverse-centaurs",
      "permanent": true
    },
    {
      "source": "/og/writing/cyborgs-centaurs-and-reverse-centaurs.png",
      "destination": "/og/writing/passengers-centaurs-and-reverse-centaurs.png",
      "permanent": true
    },
    {
      "source": "/writing/why-i-built-this-site",
      "destination": "/writing",
      "permanent": true
    },
    {
      "source": "/og/writing/why-i-built-this-site.png",
      "destination": "/og/writing.png",
      "permanent": true
    },
    {
      "source": "/tools",
      "destination": "/projects",
      "permanent": true
    },
    {
      "source": "/og/tools.png",
      "destination": "/og/projects.png",
      "permanent": true
    }
  ]
}
