---
/** One lab note: entry number, date, title, optional summary, review stamp, who wrote it, the text and its topics. */
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import AuthorshipLabel from '../../components/AuthorshipLabel.astro';
import ElementTile from '../../components/ElementTile.astro';
import ReviewStamp from '../../components/ReviewStamp.astro';
import { SITE } from '../../config/site';
import { getSite, openingOf, reviewedOn, type Post } from '../../lib/content';
import { formatDate, isoDate } from '../../lib/dates';

export async function getStaticPaths() {
  const site = await getSite();
  return site.posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

interface Props {
  post: Post;
}

const { post } = Astro.props;
const site = await getSite();
const { title, summary, date, tags, draft, authorship } = post.data;
// Search results and link previews need a description; without a summary, the note's own opening serves.
const description = summary ?? openingOf(post.body);
const frameworks = site.frameworksFor(post);
const { Content } = await render(post);
const reviewed = reviewedOn(post);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description,
  datePublished: isoDate(date),
  dateModified: isoDate(reviewed),
  author: { '@type': 'Person', name: SITE.name },
};
---

<BaseLayout
  title={title}
  description={description}
  image={`/og/writing/${post.id}.png`}
  imageAlt={`${title}, by ${SITE.name}`}
  type="article"
  published={date}
  modified={reviewed}
  jsonLd={jsonLd}
>
  <article>
    <header class="page-head measure">
      <p class="kicker">
        <span><a href="/writing">{SITE.sections.writing.label}</a></span>
        <span>Entry {site.entryOf(post)}</span>
        <span><time datetime={isoDate(date)}>{formatDate(date)}</time></span>
        {draft && <span class="draft">Draft · not published</span>}
      </p>
      <h1 class="post-title">{title}</h1>
      {summary && <p class="dek">{summary}</p>}
      <p class="meta">
        <ReviewStamp date={reviewed} />
        {
          frameworks.map((f) => (
            <a class="fw-tag" href={`/frameworks/${f.id}`}>
              <ElementTile element={site.elementOf(f)} color={site.colorOf(f)} size="chip" />
              <span class="visually-hidden">Framework: </span>
              <span class="fw-tag-name">{f.data.title}</span>
            </a>
          ))
        }
      </p>
      <div class="authorship-row"><AuthorshipLabel authorship={authorship} /></div>
    </header>
    <div class="measure prose">
      <Content />
    </div>
    {
      tags.length > 0 && (
        <footer class="measure tags">
          <span class="label">Topics</span> {tags.join(' · ')}
        </footer>
      )
    }
  </article>
</BaseLayout>

<style>
  .post-title {
    margin-top: 1rem;
    font-family: var(--font-display);
    font-weight: 750;
    font-size: clamp(2.3rem, 6.5vw, 3.6rem);
    line-height: 1.02;
    letter-spacing: -0.035em;
  }

  .draft {
    color: var(--stale-ink);
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 1.1rem;
    margin-top: 1.4rem;
  }

  .authorship-row {
    margin-top: 0.9rem;
  }

  /* The frameworks the note applies, as the same symbol chips the project cards use. */
  .fw-tag {
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
    min-height: 32px;
    font-size: 0.92rem;
    font-weight: 600;
    text-decoration: none;
  }

  .fw-tag-name {
    text-decoration: underline;
    text-decoration-color: var(--accent);
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
  }

  .fw-tag:hover .fw-tag-name {
    text-decoration-thickness: 2px;
  }

  .tags {
    margin-top: 3rem;
    padding-top: 1rem;
    border-top: 1px solid var(--rule);
    font-family: var(--font-label);
    font-size: 0.74rem;
    color: var(--ink-2);
  }

  .tags .label {
    margin-right: 0.8rem;
  }
</style>
