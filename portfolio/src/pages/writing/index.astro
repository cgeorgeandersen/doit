---
/** All published posts, newest first. */
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostList from '../../components/PostList.astro';
import { getSite } from '../../lib/content';

const { posts } = await getSite();
const description = 'Notes on getting AI into production, and on keeping the thinking current.';
---

<BaseLayout title="Writing" description={description} image="/og/writing.png" imageAlt="Writing by George Andersen">
  <header class="page-head wide">
    <p class="kicker"><span>Writing</span><span><a href="/rss.xml">RSS feed</a></span></p>
    <h1 class="page-title">Writing</h1>
    <p class="dek">{description}</p>
  </header>
  <div class="wide">
    {posts.length > 0 ? <PostList posts={posts} /> : <p class="muted">Nothing published yet.</p>}
  </div>
</BaseLayout>
