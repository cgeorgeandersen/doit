---
/** All published posts, newest first. */
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostList from '../../components/PostList.astro';
import { SITE } from '../../config/site';
import { getSite } from '../../lib/content';

const { posts } = await getSite();
const { title, description } = SITE.sections.writing;
---

<BaseLayout title="Writing" description={description} image="/og/writing.png" imageAlt={`Writing by ${SITE.name}`}>
  <header class="page-head wide">
    <p class="kicker"><span>Writing</span><span><a href="/rss.xml">RSS feed</a></span></p>
    <h1 class="page-title">{title}</h1>
    <p class="dek">{description}</p>
  </header>
  <div class="wide">
    {posts.length > 0 ? <PostList posts={posts} /> : <p class="muted">Nothing published yet.</p>}
  </div>
</BaseLayout>
