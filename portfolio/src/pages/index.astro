---
/**
 * Home: the thesis, the playbook (its six plays, each with its line to
 * remember), the methods ("How I think") with the projects that prove each
 * one, the featured projects with the methods each puts into practice, a
 * short bio, recent writing and contact. Everything below the thesis is
 * derived from the content, so new Markdown files show up here on their own.
 */
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import portrait from '../assets/george-andersen.jpg';
import ContactBand from '../components/ContactBand.astro';
import FrameworkCard from '../components/FrameworkCard.astro';
import PostList from '../components/PostList.astro';
import ProjectCard from '../components/ProjectCard.astro';
import ReviewStamp from '../components/ReviewStamp.astro';
import ThroughLine from '../components/ThroughLine.astro';
import { ASSESSMENT } from '../assessment/content';
import { tx } from '../assessment/text';
import { SITE } from '../config/site';
import { getSite, reviewedSince } from '../lib/content';
import { PLAYBOOK } from '../playbook/content';
import { PLAYBOOK_PATH } from '../playbook/model';
import { pdfStatus, PDF_PATH } from '../playbook/pdf';

const site = await getSite();
const { philosophy, methods, projects, posts } = site;
// The button beside "Read the philosophy": the AI readiness assessment (thesis.cta in site.ts).
const { cta } = SITE.thesis;

const featured = projects.filter((p) => p.data.featured);
const proof = featured.length > 0 ? featured : projects.slice(0, 2);
const liveCount = projects.filter((p) => p.data.status === 'live').length;
const since = reviewedSince(site.frameworks);

// The playbook band: each play in its framework's color, linking to it on the playbook page.
const plays = PLAYBOOK.plays.map((play, i) => {
  const framework = site.frameworks.find((f) => f.id === ASSESSMENT.dimensions.find((d) => d.id === play.dimension)?.framework);
  return { ...play, n: String(i + 1).padStart(2, '0'), color: framework ? site.colorOf(framework) : 0 };
});
const pdf = pdfStatus(site);
// The line above the headline: {braced} words are crossed out, so they sit at the odd positions.
const leadParts = SITE.thesis.lead ? SITE.thesis.lead.split(/\{([^}]*)\}/) : [];
const plural = (n: number, one: string, many: string) => `${n} ${n === 1 ? one : many}`;

// Split the headline around the emphasized word, which sits on the four-color stripe.
const { headline, emphasis } = SITE.thesis;
const at = emphasis ? headline.indexOf(emphasis) : -1;
const [before, after] = at >= 0 ? [headline.slice(0, at), headline.slice(at + emphasis.length)] : [headline, ''];

const personLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: SITE.name,
  jobTitle: SITE.role,
  description: SITE.description,
  url: Astro.site?.href,
  sameAs: [SITE.contact.linkedin].filter(Boolean),
};
---

<BaseLayout jsonLd={personLd}>
  <section class="hero wide" aria-labelledby="hero-title">
    <div class="hero-grid">
      <div class="hero-text">
        {
          leadParts.length > 0 && (
            <p class="hero-lead">
              <span>{leadParts.map((part, i) => (i % 2 === 1 ? <s aria-hidden="true">{part}</s> : part))}</span>
              {SITE.thesis.leadAnswer && (
                <span class="lead-answer">
                  <span class="lead-arrow" aria-hidden="true">
                    →
                  </span>{' '}
                  {SITE.thesis.leadAnswer}
                </span>
              )}
            </p>
          )
        }
        <h1 id="hero-title" class="hero-title">
          {before}{at >= 0 && <span class="emphasis">{emphasis}</span>}{after}
        </h1>
        <p class="dek hero-dek">{SITE.thesis.dek}</p>
        {
          (cta || philosophy) && (
            <div class="hero-actions">
              {cta && (
                <a class="btn btn--primary hero-cta" href={cta.href}>
                  <span class="hero-cta-label">{cta.label}</span>
                  <span class="hero-cta-note">
                    {cta.note} <span class="arrow" aria-hidden="true">→</span>
                  </span>
                </a>
              )}
              {philosophy && (
                <a class="more" href={`/frameworks/${philosophy.id}`}>
                  {SITE.thesis.linkLabel} <span aria-hidden="true">→</span>
                </a>
              )}
            </div>
          )
        }
      </div>
      <figure class="hero-portrait">
        <div class="photo">
          <Image
            src={portrait}
            alt={SITE.bio.portraitAlt}
            widths={[240, 400]}
            sizes="(min-width: 1100px) 15rem, (min-width: 720px) 11rem, 5rem"
            loading="eager"
          />
        </div>
        <figcaption>
          <span class="who">{SITE.name}</span>
          <span class="role">{SITE.role}</span>
        </figcaption>
      </figure>
    </div>
    <ul class="hero-meta" aria-label="At a glance">
      <li>{plural(methods.length, 'method', 'methods')}</li>
      <li>{plural(liveCount, 'live project', 'live projects')}</li>
      {
        since && (
          <li>
            <ReviewStamp date={since} label="Frameworks reviewed since" />
          </li>
        )
      }
    </ul>
  </section>

  <section class="section playbook-band" aria-labelledby="playbook-title">
    <div class="wide band">
      <div class="band-text">
        <p class="kicker">
          <span>{PLAYBOOK.intro.label}</span>
          {PLAYBOOK.intro.kicker.map((item) => <span>{tx(item)}</span>)}
        </p>
        <h2 id="playbook-title" class="section-title">
          {tx(PLAYBOOK.intro.title)}
        </h2>
        <p class="band-dek">{tx(PLAYBOOK.intro.dek)}</p>
        <p class="band-actions">
          <a class="btn btn--primary" href={PLAYBOOK_PATH}>
            {SITE.home.playbookLink} <span class="arrow" aria-hidden="true">→</span>
          </a>
          {
            pdf.ready && (
              <a class="more" href={PDF_PATH} download={`${PLAYBOOK.name} (${SITE.name}).pdf`}>
                {PLAYBOOK.intro.download} <span aria-hidden="true">↓</span>
              </a>
            )
          }
        </p>
      </div>
      <ol class="band-plays">
        {
          plays.map((play) => (
            <li data-fw={play.color}>
              <a href={`${PLAYBOOK_PATH}#${play.dimension}`}>
                <span class="band-num" aria-hidden="true">
                  {play.n}
                </span>
                <span class="band-play">
                  <span class="band-title">{tx(play.title)}</span>
                  <span class="band-model">{tx(play.model)}</span>
                </span>
              </a>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  {
    methods.length > 0 && (
      <section class="section" aria-labelledby="methods-title">
        <div class="wide">
          <header class="section-head">
            <h2 id="methods-title" class="section-title">
              {SITE.home.methodsHeading}
            </h2>
            <p>{SITE.home.methodsIntro}</p>
          </header>
          <ol class="methods">
            {methods.map((framework) => (
              <li>
                <FrameworkCard
                  framework={framework}
                  element={site.elementOf(framework)}
                  color={site.colorOf(framework)}
                  projects={site.projectsFor(framework).applied}
                  notes={site.notesFor(framework)}
                />
              </li>
            ))}
          </ol>
        </div>
      </section>
    )
  }

  {
    proof.length > 0 && (
      <section class="section" aria-labelledby="proof-title">
        <div class="wide">
          <header class="section-head section-head--split">
            <h2 id="proof-title" class="section-title">
              {SITE.home.proofHeading}
            </h2>
            <p>{SITE.home.proofIntro}</p>
            {projects.length > proof.length && (
              <p>
                <a class="more" href="/projects">
                  All {projects.length} projects <span aria-hidden="true">→</span>
                </a>
              </p>
            )}
          </header>
          <div class="proof">
            {proof.map((project) => (
              <ProjectCard project={project} frameworks={site.frameworksFor(project)} elementOf={site.elementOf} colorOf={site.colorOf} />
            ))}
          </div>
        </div>
      </section>
    )
  }

  <section class="section" aria-labelledby="about-title">
    <div class="wide about">
      <div class="about-body">
        <h2 id="about-title" class="label">About</h2>
        <p class="about-text">{SITE.bio.text}</p>
        <p>
          <a class="more" href="/about">{SITE.bio.linkLabel} <span aria-hidden="true">→</span></a>
        </p>
      </div>
      <ThroughLine />
    </div>
  </section>

  {
    posts.length > 0 && (
      <section class="section" aria-labelledby="writing-title">
        <div class="wide">
          <h2 id="writing-title" class="label">
            {SITE.home.writingHeading}
          </h2>
          <div>
            <PostList posts={posts.slice(0, 3)} entryOf={site.entryOf} headingLevel="h3" compact />
            <p class="all-writing">
              <a class="more" href="/writing">
                {SITE.home.writingLink} <span aria-hidden="true">→</span>
              </a>
            </p>
          </div>
        </div>
      </section>
    )
  }

  <ContactBand />
</BaseLayout>

<style>
  .hero {
    padding-block: clamp(2.75rem, 8vw, 5.5rem) clamp(2.5rem, 6vw, 4rem);
  }

  /* Phones: the photo is a compact byline above the headline. From 720px it
     moves to the right of the text, and on wide screens it becomes a card. The
     text comes first in the source, so screen readers meet the headline first. */
  .hero-grid {
    display: grid;
    grid-template-areas: 'photo' 'text';
    gap: 1.6rem;
  }

  .hero-text {
    grid-area: text;
    min-width: 0;
  }

  /* "AI today is ~~magic~~ alchemy. → Let’s turn it into chemistry." */
  .hero-lead {
    display: flex;
    flex-wrap: wrap;
    gap: 0.15rem 0.6rem;
    max-width: 40rem;
    margin-bottom: 1.2rem;
    font-size: clamp(1.02rem, 2.1vw, 1.22rem);
    line-height: 1.4;
    color: var(--ink-2);
  }

  .hero-lead s {
    color: var(--ink-3);
    text-decoration-color: var(--fw-2);
    text-decoration-thickness: 2px;
  }

  .lead-answer {
    color: var(--ink);
  }

  .lead-arrow {
    font-weight: 600;
    color: var(--accent-ink);
  }

  .hero-portrait {
    grid-area: photo;
    display: flex;
    align-items: center;
    gap: 1rem;
    margin: 0;
  }

  .photo {
    flex: none;
    width: 5rem;
    padding-bottom: 4px;
    background: linear-gradient(90deg, var(--fw-0) 0 25%, var(--fw-1) 25% 50%, var(--fw-2) 50% 75%, var(--fw-3) 75% 100%)
      no-repeat 0 100% / 100% 4px;
  }

  .photo :global(img) {
    display: block;
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
    border-radius: 12px 12px 0 0;
    filter: grayscale(1);
  }

  figcaption {
    display: grid;
    gap: 0.2rem;
  }

  .who {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.15rem;
    letter-spacing: -0.02em;
    line-height: 1.15;
  }

  .role {
    font-size: 0.82rem;
    line-height: 1.4;
    color: var(--ink-3);
  }

  @media (min-width: 720px) {
    .hero-grid {
      grid-template-areas: 'text photo';
      grid-template-columns: minmax(0, 1fr) 11rem;
      align-items: end;
      column-gap: 3rem;
    }

    .hero-portrait {
      flex-direction: column;
      align-items: stretch;
      gap: 0.9rem;
    }

    .photo {
      width: 100%;
      padding-bottom: 6px;
      background-size: 100% 6px;
    }

    .photo :global(img) {
      border-radius: 18px 18px 0 0;
    }
  }

  /* Wide screens: the photo becomes a card that stands as tall as the headline. */
  @media (min-width: 1100px) {
    .hero-grid {
      grid-template-columns: minmax(0, 1fr) 15rem;
      column-gap: 5rem;
    }
  }

  /*
   * Two big lines at every width: "AI should / be boring." The longer line is
   * about 4.2em wide and "AI should be" about 4.9em, so a 4.5em box breaks it
   * there. Each size keeps that box inside the text column beside the photo.
   * A new headline needs re-measuring; keep it to two short lines.
   */
  .hero-title {
    max-width: 4.5em;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(3.2rem, 20vw, 5.4rem);
    line-height: 0.94;
    letter-spacing: -0.045em;
  }

  @media (min-width: 720px) {
    .hero-title {
      font-size: clamp(3.6rem, 10vw, 6.2rem);
    }
  }

  @media (min-width: 1100px) {
    .hero-title {
      font-size: clamp(6rem, 9vw, 8rem);
    }
  }

  /* One stripe per framework color under the key word: the site's signature. */
  .emphasis {
    padding-bottom: 0.06em;
    background: linear-gradient(90deg, var(--fw-0) 0 25%, var(--fw-1) 25% 50%, var(--fw-2) 50% 75%, var(--fw-3) 75% 100%)
      no-repeat 0 96% / 100% 0.1em;
  }

  .hero-dek {
    max-width: 34ch;
    margin-top: clamp(1.8rem, 3.5vw, 2.2rem);
    font-size: clamp(1.25rem, 2.6vw, 1.5rem);
    line-height: 1.4;
  }

  @media (min-width: 1100px) {
    .hero-dek {
      max-width: 40ch;
      font-size: 1.35rem;
    }
  }

  /* The assessment button and the philosophy link, side by side when they fit. */
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.6rem;
    margin-top: 1.6rem;
  }

  /* Two lines: the question, then what you get. */
  .hero-cta {
    flex-direction: column;
    align-items: flex-start;
    gap: 0.1rem;
    padding: 0.7rem 1.3rem 0.75rem;
    text-align: left;
  }

  .hero-cta-label {
    font-family: var(--font-display);
    font-size: 1.15rem;
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: -0.02em;
  }

  .hero-cta-note {
    font-size: 0.82rem;
    font-weight: 500;
  }

  .hero-cta:hover .arrow {
    transform: translateX(3px);
  }

  .hero-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem 1.6rem;
    margin: clamp(2rem, 5vw, 3rem) 0 0;
    padding: 1rem 0 0;
    list-style: none;
    border-top: 1px solid var(--rule);
    font-family: var(--font-label);
    font-size: 0.74rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-3);
  }

  /* One quiet entrance, off when the reader prefers reduced motion. The
     headline only moves (it never starts invisible), so it paints at once. */
  @media (prefers-reduced-motion: no-preference) {
    .hero-title {
      animation: settle 700ms var(--ease) both;
    }

    .hero-dek,
    .hero-actions,
    .hero-portrait,
    .hero-meta {
      animation: rise 700ms var(--ease) both;
      animation-delay: 120ms;
    }

    .hero-meta {
      animation-delay: 220ms;
    }

    @keyframes settle {
      from {
        transform: translateY(0.06em);
      }
    }

    @keyframes rise {
      from {
        opacity: 0;
        transform: translateY(10px);
      }
    }
  }

  /* The playbook: the site's centerpiece, on a band of its own under the hero. */
  .playbook-band {
    background: var(--paper-2);
  }

  .band {
    display: grid;
    gap: 2rem;
    align-items: center;
  }

  @media (min-width: 900px) {
    .band {
      grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
      column-gap: clamp(2.5rem, 6vw, 5rem);
    }
  }

  .band-text {
    display: grid;
    gap: 1rem;
    justify-items: start;
  }

  .band-dek {
    max-width: 34rem;
    font-size: var(--step-1);
    line-height: 1.45;
    color: var(--ink-2);
  }

  .band-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.5rem;
    margin-top: 0.4rem;
  }

  /* The six plays, like the sheet itself: numbers in their framework's color, the line to remember under each title. */
  .band-plays {
    display: grid;
    margin: 0;
    padding: 0.4rem 1.3rem;
    list-style: none;
    border: 1px solid var(--rule);
    border-radius: 16px;
    background:
      linear-gradient(90deg, var(--fw-0) 0 25%, var(--fw-1) 25% 50%, var(--fw-2) 50% 75%, var(--fw-3) 75% 100%) no-repeat 0 0 / 100% 5px,
      var(--paper);
  }

  .band-plays li + li {
    border-top: 1px solid var(--rule);
  }

  .band-plays a {
    display: grid;
    grid-template-columns: 2.6rem minmax(0, 1fr);
    align-items: baseline;
    gap: 0.9rem;
    padding: 0.85rem 0;
    text-decoration: none;
  }

  .band-num {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.6rem;
    line-height: 1;
    letter-spacing: -0.04em;
    color: var(--fw-ink);
    font-variant-numeric: tabular-nums;
  }

  .band-play {
    display: grid;
    gap: 0.15rem;
  }

  .band-title {
    font-family: var(--font-display);
    font-weight: 750;
    font-size: 1.2rem;
    line-height: 1.15;
    letter-spacing: -0.025em;
    text-decoration: underline;
    text-decoration-color: transparent;
    text-underline-offset: 0.18em;
    transition: text-decoration-color 140ms var(--ease);
  }

  .band-plays a:hover .band-title,
  .band-plays a:focus-visible .band-title {
    text-decoration-color: var(--accent);
  }

  .band-model {
    color: var(--ink-2);
    line-height: 1.4;
  }

  .methods {
    display: grid;
    gap: 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .methods > li {
    min-width: 0;
  }

  @media (min-width: 900px) {
    .methods {
      grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
      gap: 1rem;
    }
  }

  .section-head--split p:last-child {
    margin-top: 0.2rem;
  }

  .proof {
    display: grid;
    gap: 3.5rem;
  }

  @media (min-width: 900px) {
    .proof {
      grid-template-columns: repeat(auto-fit, minmax(20rem, 1fr));
      gap: 3rem clamp(2rem, 4vw, 3.5rem);
    }
  }

  .about {
    display: grid;
    gap: 2.5rem;
    align-items: center;
  }

  @media (min-width: 900px) {
    .about {
      grid-template-columns: minmax(0, 1fr) minmax(0, 24rem);
      column-gap: clamp(3rem, 7vw, 6rem);
    }
  }

  .about-body {
    display: grid;
    gap: 1.1rem;
    max-width: 40rem;
  }

  .about-text {
    font-size: var(--step-1);
    line-height: 1.5;
  }

  .all-writing {
    margin-top: 1rem;
  }

</style>
