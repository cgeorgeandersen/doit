---
/**
 * One framework: its element tile, question, thesis, optional formula, review
 * stamp and the essay itself, then its failure modes. The projects that apply
 * it sit in the margin (derived from each project's `frameworks` list, so it
 * can't fall out of date).
 */
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ElementTile from '../../components/ElementTile.astro';
import FailureModes from '../../components/FailureModes.astro';
import ReviewStamp from '../../components/ReviewStamp.astro';
import StatusPill from '../../components/StatusPill.astro';
import { SITE } from '../../config/site';
import { domainOf, getSite, type Framework, type Project } from '../../lib/content';
import { formatDate, isoDate } from '../../lib/dates';

export async function getStaticPaths() {
  const site = await getSite();
  return site.frameworks.map((framework) => ({ params: { slug: framework.id }, props: { framework } }));
}

interface Props {
  framework: Framework;
}

const { framework } = Astro.props;
const site = await getSite();
const { title, thesis, question, date, lastReviewed, kind, reaction, failureModes, draft } = framework.data;
const { Content } = await render(framework);
const number = site.numberOf(framework);
const color = site.colorOf(framework);
const { applied, related } = site.projectsFor(framework);
const others = site.frameworks.filter((f) => f.id !== framework.id);

const groups: { label: string; projects: Project[] }[] = [
  { label: 'Applied in', projects: applied },
  { label: 'Related', projects: related },
].filter((g) => g.projects.length > 0);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description: thesis,
  datePublished: isoDate(date),
  dateModified: isoDate(lastReviewed),
  author: { '@type': 'Person', name: SITE.name },
};
---

<BaseLayout
  title={title}
  description={thesis}
  image={`/og/frameworks/${framework.id}.png`}
  imageAlt={`${title}: a framework by ${SITE.name}`}
  type="article"
  published={date}
  modified={lastReviewed}
  jsonLd={jsonLd}
>
  <article>
    <header class="page-head wide fw-head">
      <p class="kicker">
          <span><a href="/frameworks">{SITE.sections.frameworks.label}</a></span>
          <span class="method" data-fw={color}>{number ? `Method ${number}` : kind === 'philosophy' ? 'The philosophy' : 'Framework'}</span>
          {question && <span>{question}</span>}
        {draft && <span class="draft">Draft · not published</span>}
      </p>
      <h1 class="page-title">{title}</h1>
      <div class="fw-head-tile">
        <ElementTile element={site.elementOf(framework)} color={color} />
      </div>
      <p class="dek">{thesis}</p>
      {
        reaction && (
          <p class="reaction">
            {reaction.inputs.map((input, i) => (
              <Fragment>
                {i > 0 && (
                  <span class="op">
                    <span aria-hidden="true">+</span>
                    <span class="visually-hidden">plus</span>
                  </span>
                )}
                <span class="term">{input}</span>
              </Fragment>
            ))}
            <span class="yields">
              <span aria-hidden="true">→</span>
              <span class="visually-hidden">gives</span> {reaction.output}
            </span>
          </p>
        )
      }
      <p class="meta">
        <ReviewStamp date={lastReviewed} />
        <span>First published <time datetime={isoDate(date)}>{formatDate(date)}</time></span>
      </p>
    </header>

    <div class="detail">
      <aside class="detail-aside" aria-label="Where this framework is used">
        {
          groups.map((group) => (
            <div class="aside-block">
              <h2 class="label">{group.label}</h2>
              <ul class="projects">
                {group.projects.map((project) => (
                  <li>
                    <a class="project" href={`/projects/${project.id}`}>
                      <span class="project-title">{project.data.title}</span>
                      <span class="project-meta">
                        <StatusPill status={project.data.status} />
                        {project.data.liveUrl && <span>{domainOf(project.data.liveUrl)}</span>}
                      </span>
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
        {
          groups.length === 0 && (
            <div class="aside-block">
              <h2 class="label">Applied in</h2>
              <p class="none">No public project applies this framework yet.</p>
            </div>
          )
        }
      </aside>

      <div class="detail-main">
        <div class="prose">
          <Content />
        </div>
        <FailureModes modes={failureModes} />
      </div>
    </div>

    {
      others.length > 0 && (
        <nav class="wide others" aria-labelledby="others-title">
          <h2 id="others-title" class="label">
            Other frameworks
          </h2>
          <ul>
            {others.map((f) => (
              <li>
                <a href={`/frameworks/${f.id}`}>
                  <ElementTile element={site.elementOf(f)} color={site.colorOf(f)} size="chip" />
                  <span class="other-title">{f.data.title}</span>
                </a>
              </li>
            ))}
          </ul>
        </nav>
      )
    }
  </article>
</BaseLayout>

<style>
  .draft {
    color: var(--stale-ink);
  }

  /*
   * The framework's element tile: beside the title on phones (a small tile, so
   * the headline stays near the top), beside the whole header from 900px.
   */
  .fw-head {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    grid-template-areas:
      'kicker kicker'
      'title tile'
      'dek dek'
      'reaction reaction'
      'meta meta';
    column-gap: 1.2rem;
  }

  .fw-head > .kicker {
    grid-area: kicker;
  }

  .fw-head > .page-title {
    grid-area: title;
    align-self: center;
  }

  .fw-head > .dek {
    grid-area: dek;
  }

  .fw-head > .reaction {
    grid-area: reaction;
  }

  .fw-head > .meta {
    grid-area: meta;
  }

  .fw-head-tile {
    grid-area: tile;
    align-self: end;
    width: 5.2rem;
    margin-top: 1rem;
  }

  .fw-head-tile :global(.el) {
    min-height: 0;
    aspect-ratio: 1;
    padding: 0.4rem 0.5rem;
  }

  .fw-head-tile :global(.el-kind) {
    display: none;
  }

  .fw-head-tile :global(.el-symbol) {
    font-size: 2.2rem;
  }

  @media (min-width: 900px) {
    .fw-head {
      grid-template-columns: minmax(0, 1fr) 11rem;
      grid-template-areas:
        'kicker tile'
        'title tile'
        'dek tile'
        'reaction tile'
        'meta tile';
      column-gap: 4rem;
    }

    .fw-head-tile {
      align-self: center;
      width: 100%;
      margin-top: 0;
    }

    .fw-head-tile :global(.el) {
      padding: 0.8rem 0.95rem 0.9rem;
    }

    .fw-head-tile :global(.el-kind) {
      display: block;
    }

    .fw-head-tile :global(.el-number) {
      font-size: 1.05rem;
    }

    .fw-head-tile :global(.el-symbol) {
      font-size: 4.6rem;
    }
  }

  /* The formula: ingredients joined by +, then what they make. */
  .reaction {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.35rem 0.7rem;
    width: fit-content;
    max-width: 100%;
    margin-top: 1.4rem;
    padding: 0.8rem 1.1rem;
    border-radius: var(--radius);
    background: var(--paper-2);
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.05rem;
    letter-spacing: -0.01em;
  }

  .op {
    font-weight: 500;
    color: var(--ink-3);
  }

  .yields {
    color: var(--accent-ink);
  }

  /* An opening paragraph before the first heading reads as a lede. */
  .prose > :global(p:first-child) {
    font-size: var(--step-1);
    line-height: 1.5;
    color: var(--ink);
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem 1.2rem;
    margin-top: 1.6rem;
    font-family: var(--font-label);
    font-size: 0.74rem;
    letter-spacing: 0.03em;
    color: var(--ink-3);
  }

  .projects {
    display: grid;
    gap: 0.4rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .project {
    display: grid;
    gap: 0.3rem;
    padding: 0.8rem 0.95rem;
    border: 1px solid var(--rule-strong);
    border-radius: var(--radius);
    text-decoration: none;
    transition: border-color 140ms var(--ease);
  }

  .project:hover {
    border-color: var(--ink-3);
  }

  .project-title {
    font-family: var(--font-display);
    font-weight: 700;
    letter-spacing: -0.025em;
    font-size: 1.25rem;
    line-height: 1.15;
  }

  .project-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem 0.9rem;
    font-family: var(--font-label);
    font-size: 0.7rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-3);
  }

  .none {
    font-size: 0.9rem;
    color: var(--ink-3);
  }

  .others {
    display: grid;
    gap: 0.9rem;
    margin-top: var(--section);
    padding-top: 1.5rem;
    border-top: 1px solid var(--rule);
  }

  .others ul {
    display: grid;
    gap: 0.2rem 2rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .others a {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    min-height: 40px;
    padding-block: 0.3rem;
    text-decoration: none;
  }

  /* "Method 2" in its framework's color. */
  .method {
    color: var(--fw-ink);
  }

  .other-title {
    font-family: var(--font-display);
    font-weight: 700;
    letter-spacing: -0.025em;
    font-size: 1.35rem;
    line-height: 1.2;
  }

  .others a:hover .other-title {
    text-decoration: underline;
    text-decoration-color: var(--accent);
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
  }

  @media (min-width: 720px) {
    .others ul {
      grid-template-columns: repeat(auto-fill, minmax(16rem, 1fr));
    }
  }
</style>
