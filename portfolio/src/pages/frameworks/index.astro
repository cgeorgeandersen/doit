---
/**
 * Every framework as an element in a small periodic table, then the philosophy,
 * then the numbered methods, each with the projects that apply it.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import ElementTile from '../../components/ElementTile.astro';
import FrameworkCard from '../../components/FrameworkCard.astro';
import ReviewStamp from '../../components/ReviewStamp.astro';
import { SITE } from '../../config/site';
import { getSite } from '../../lib/content';

const site = await getSite();
const { philosophy, methods } = site;
const { label, title, description } = SITE.sections.frameworks;
---

<BaseLayout title={label} description={description} image="/og/frameworks.png" imageAlt={`${label} by ${SITE.name}`}>
  <header class="page-head wide index-head">
    <div class="index-head-text">
      <p class="kicker"><span>{label}</span></p>
      <h1 class="page-title">{title}</h1>
      <p class="dek">{description}</p>
    </div>
    <ul class="table" aria-label="Every framework">
      {
        site.frameworks.map((framework) => (
          <li>
            <ElementTile
              element={site.elementOf(framework)}
              color={site.colorOf(framework)}
              name={framework.data.title}
              question={framework.data.question}
              href={`/frameworks/${framework.id}`}
            />
          </li>
        ))
      }
    </ul>
  </header>

  {
    philosophy && (
      <section class="wide philosophy" aria-labelledby="philosophy-title">
        <p class="label">The philosophy</p>
        <h2 id="philosophy-title" class="philosophy-title">
          <a class="quiet-link" href={`/frameworks/${philosophy.id}`}>
            {philosophy.data.title}
          </a>
        </h2>
        <p class="philosophy-thesis">{philosophy.data.thesis}</p>
        <p class="philosophy-meta">
          <ReviewStamp date={philosophy.data.lastReviewed} />
          <a class="more" href={`/frameworks/${philosophy.id}`}>
            Read the philosophy <span aria-hidden="true">→</span>
          </a>
        </p>
      </section>
    )
  }

  {
    methods.length > 0 && (
      <section class="wide" aria-labelledby="methods-title">
        <div class="section-head methods-head">
          <h2 id="methods-title" class="label">
            The methods
          </h2>
          <p>{SITE.home.methodsIntro}</p>
        </div>
        <ol class="methods">
          {methods.map((framework) => {
            const { applied, related } = site.projectsFor(framework);
            return (
              <li>
                <FrameworkCard
                  framework={framework}
                  element={site.elementOf(framework)}
                  color={site.colorOf(framework)}
                  projects={[...applied, ...related]}
                  notes={site.notesFor(framework)}
                  headingLevel="h3"
                />
              </li>
            );
          })}
        </ol>
      </section>
    )
  }

  <p class="wide review-note">
    I re-read every framework at least every {Math.round(SITE.review.staleAfterDays / 30)} months. When one is overdue, its stamp turns amber.
  </p>
</BaseLayout>

<style>
  /* The table: two by two, like the four-dot mark, beside the title on wide screens. */
  .index-head {
    display: grid;
    gap: 2.2rem;
  }

  .table {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    grid-auto-rows: 1fr;
    gap: 0.7rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .table > li {
    display: grid;
    min-width: 0;
  }

  @media (min-width: 720px) {
    .table {
      grid-template-columns: repeat(auto-fill, minmax(9.5rem, 1fr));
    }
  }

  @media (min-width: 1100px) {
    .index-head {
      grid-template-columns: minmax(0, 1fr) 24rem;
      column-gap: 4rem;
      align-items: center;
    }

    .table {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .philosophy {
    display: grid;
    gap: 0.9rem;
    padding: clamp(1.6rem, 4vw, 2.6rem);
    border: 1px solid var(--rule-strong);
    border-radius: var(--radius);
    background: var(--paper-2);
  }

  .philosophy-title {
    font-family: var(--font-display);
    font-weight: 750;
    font-size: clamp(2.2rem, 6vw, 3.6rem);
    line-height: 1;
    letter-spacing: -0.035em;
  }

  .philosophy-thesis {
    max-width: 32ch;
    font-size: clamp(1.2rem, 2.4vw, 1.45rem);
    line-height: 1.4;
    color: var(--ink-2);
  }

  .philosophy-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.8rem 1.6rem;
    margin-top: 0.4rem;
  }

  .methods-head {
    margin-top: clamp(3rem, 7vw, 4.5rem);
    margin-bottom: 1.5rem;
  }

  .methods {
    display: grid;
    gap: 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .methods > li {
    min-width: 0;
  }

  @media (min-width: 900px) {
    .methods {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
      gap: 1rem;
    }
  }

  .review-note {
    margin-top: 2rem;
    font-family: var(--font-label);
    font-size: 0.74rem;
    line-height: 1.6;
    color: var(--ink-3);
  }
</style>
