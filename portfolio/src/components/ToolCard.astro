---
/**
 * A tool or resource on /tools: what it is and how long it takes, its name and
 * summary, the frameworks it puts into practice, and two ways in: the tool
 * itself and the project page that tells how it was built.
 *
 * The cover is the linked project's, so it's never stored twice. The band on
 * top wears the framework's color, or the four-color stripe when the tool puts
 * several frameworks into practice.
 */
import { Image } from 'astro:assets';
import { render } from 'astro:content';
import ElementTile from './ElementTile.astro';
import { domainOf, type Framework, type FrameworkElement, type Project, type Tool } from '../lib/content';

interface Props {
  tool: Tool;
  frameworks: Framework[];
  project: Project | undefined;
  elementOf: (framework: Framework) => FrameworkElement;
  colorOf: (framework: Framework) => 0 | 1 | 2 | 3 | 4;
  headingLevel?: 'h2' | 'h3';
}

const { tool, frameworks, project, elementOf, colorOf, headingLevel = 'h2' } = Astro.props;
const { title, summary, kind, time, href, action, draft } = tool.data;
const { Content } = await render(tool);
const hasBody = Boolean(tool.body?.trim());
const external = href.startsWith('https://');
const cover = project?.data.cover;
const band = frameworks.length === 1 ? colorOf(frameworks[0]!) : undefined;
const Heading = headingLevel;
---

<article class:list={['tool-card', { 'tool-card--stripe': band === undefined }]} data-fw={band}>
  {
    cover && (
      <a class="media" href={href} tabindex="-1" aria-hidden="true" target={external ? '_blank' : undefined} rel={external ? 'noopener' : undefined}>
        <Image src={cover} alt="" widths={[480, 720, 960]} sizes="(min-width: 1000px) 22rem, (min-width: 640px) 45vw, calc(100vw - 32px)" loading="lazy" />
      </a>
    )
  }
  <div class="body">
    <p class="kicker">
      <span>{kind}</span>
      {time && <span>{time}</span>}
      {draft && <span class="draft">Draft · not published</span>}
    </p>
    <Heading class="title">{title}</Heading>
    <p class="summary">{summary}</p>
    {
      hasBody && (
        <div class="more-text">
          <Content />
        </div>
      )
    }
    {
      frameworks.length > 0 && (
        <div class="practice">
          <p class="label">Puts into practice</p>
          <ul>
            {frameworks.map((f) => (
              <li>
                <a href={`/frameworks/${f.id}`}>
                  <ElementTile element={elementOf(f)} color={colorOf(f)} size="chip" />
                  <span class="name">{f.data.title}</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      )
    }
    <p class="actions">
      {
        external ? (
          <a class="btn btn--primary" href={href} target="_blank" rel="noopener">
            {action} <span class="arrow" aria-hidden="true">↗</span>
            <span class="visually-hidden">(opens {domainOf(href)} in a new tab)</span>
          </a>
        ) : (
          <a class="btn btn--primary" href={href}>
            {action} <span class="arrow" aria-hidden="true">→</span>
          </a>
        )
      }
      {
        project && (
          <a class="more" href={`/projects/${project.id}`}>
            Read the case study <span aria-hidden="true">→</span>
          </a>
        )
      }
    </p>
  </div>
</article>

<style>
  .tool-card {
    display: grid;
    grid-template-rows: auto 1fr;
    height: 100%;
    overflow: hidden;
    border: 1px solid var(--rule);
    border-radius: 16px;
    background: var(--paper);
    box-shadow: inset 0 5px 0 var(--fw);
  }

  /* Several frameworks: the site's four-color stripe instead of one color. */
  .tool-card--stripe {
    box-shadow: none;
    background:
      linear-gradient(90deg, var(--fw-0) 0 25%, var(--fw-1) 25% 50%, var(--fw-2) 50% 75%, var(--fw-3) 75% 100%) no-repeat 0 0 / 100% 5px,
      var(--paper);
  }

  .media {
    display: block;
    margin: 5px 0 0;
    border-bottom: 1px solid var(--rule);
    background: var(--paper-2);
  }

  .media :global(img) {
    width: 100%;
    aspect-ratio: 1200 / 630;
    object-fit: cover;
    transition: transform 400ms var(--ease);
  }

  .tool-card:hover .media :global(img) {
    transform: scale(1.015);
  }

  /* A column whose actions sit at the bottom, so buttons line up across cards. */
  .body {
    display: flex;
    flex-direction: column;
    gap: 0.8rem;
    padding: 1.3rem 1.3rem 1.4rem;
  }

  .draft {
    color: var(--stale-ink);
  }

  .title {
    font-family: var(--font-display);
    font-weight: 750;
    font-size: clamp(1.5rem, 2.6vw, 1.85rem);
    line-height: 1.08;
    letter-spacing: -0.035em;
  }

  .summary {
    color: var(--ink-2);
  }

  .more-text {
    color: var(--ink-2);
    font-size: 0.95rem;
  }

  .practice {
    display: grid;
    gap: 0.35rem;
    align-content: start;
    padding-top: 0.2rem;
  }

  .practice ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.2rem 1.1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .practice a {
    display: inline-flex;
    align-items: center;
    gap: 0.55em;
    min-height: 32px;
    font-weight: 600;
    font-size: 0.92rem;
    text-decoration: none;
  }

  .name {
    text-decoration: underline;
    text-decoration-color: var(--accent);
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
  }

  .practice a:hover .name {
    text-decoration-thickness: 2px;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.9rem 1.4rem;
    margin-top: auto;
    padding-top: 0.4rem;
  }

  @media (prefers-reduced-motion: reduce) {
    .media :global(img) {
      transition: none;
    }

    .tool-card:hover .media :global(img) {
      transform: none;
    }
  }
</style>
