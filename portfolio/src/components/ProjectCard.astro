---
/**
 * A project as proof: status and what it is, title, summary, the frameworks it
 * puts into practice (each with its element symbol, like a formula), and two
 * ways in: the project itself (its `action`, like "Take the assessment"; a new
 * tab only when it lives on another site) and its case study.
 * `stack` puts the cover on top (home); `row` puts it beside the text (/projects).
 */
import { Image } from 'astro:assets';
import ElementTile from './ElementTile.astro';
import StatusPill from './StatusPill.astro';
import { domainOf, openLink, type FrameworkElement, type Framework, type Project } from '../lib/content';
import { year } from '../lib/dates';

interface Props {
  project: Project;
  frameworks: Framework[];
  elementOf: (framework: Framework) => FrameworkElement;
  colorOf: (framework: Framework) => 0 | 1 | 2 | 3 | 4;
  layout?: 'stack' | 'row';
  headingLevel?: 'h2' | 'h3';
}

const { project, frameworks, elementOf, colorOf, layout = 'stack', headingLevel = 'h3' } = Astro.props;
const { title, summary, status, date, cover, kind, time, draft } = project.data;
const open = openLink(project, Astro.site);
const Heading = headingLevel;
const href = `/projects/${project.id}`;
const sizes = layout === 'row' ? '(min-width: 900px) 24rem, calc(100vw - 32px)' : '(min-width: 900px) 33rem, calc(100vw - 32px)';
---

<article class:list={['project-card', `project-card--${layout}`]}>
  {
    cover && (
      <a class="media" href={href} tabindex="-1" aria-hidden="true">
        <Image src={cover} alt="" widths={[480, 720, 960, 1200]} sizes={sizes} loading="lazy" />
      </a>
    )
  }
  <div class="body">
    <p class="kicker">
      <span><StatusPill status={status} /></span>
      <span>{kind ?? year(date)}</span>
      {time && <span>{time}</span>}
      {draft && <span class="draft">Draft · not published</span>}
    </p>
    <Heading class="title"><a class="quiet-link" href={href}>{title}</a></Heading>
    <p class="summary">{summary}</p>
    {
      frameworks.length > 0 && (
        <div class="practice">
          <p class="label">Puts into practice</p>
          <ul>
            {frameworks.map((f) => (
              <li>
                <a href={`/frameworks/${f.id}`}>
                  <ElementTile element={elementOf(f)} color={colorOf(f)} size="chip" />
                  <span class="name">{f.data.title}</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      )
    }
    <p class="actions">
      {
        open &&
          (open.external ? (
            <a class="btn btn--primary" href={open.href} target="_blank" rel="noopener">
              {open.label} <span class="arrow" aria-hidden="true">↗</span>
              <span class="visually-hidden">(opens {domainOf(open.href)} in a new tab)</span>
            </a>
          ) : (
            <a class="btn btn--primary" href={open.href}>
              {open.label} <span class="arrow" aria-hidden="true">→</span>
            </a>
          ))
      }
      <a class="more" href={href}>Read the case study <span aria-hidden="true">→</span></a>
    </p>
  </div>
</article>

<style>
  .project-card {
    display: grid;
    gap: 1.3rem;
    align-content: start;
  }

  .media {
    display: block;
    overflow: hidden;
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    background: var(--paper-2);
  }

  .media :global(img) {
    width: 100%;
    aspect-ratio: 1200 / 630;
    object-fit: cover;
    transition: transform 400ms var(--ease);
  }

  .project-card:hover .media :global(img) {
    transform: scale(1.015);
  }

  .body {
    display: grid;
    gap: 0.8rem;
    align-content: start;
  }

  .draft {
    color: var(--stale-ink);
  }

  .title {
    font-family: var(--font-display);
    font-weight: 750;
    font-size: clamp(1.6rem, 3.2vw, 2.05rem);
    line-height: 1.08;
    letter-spacing: -0.035em;
  }

  .summary {
    color: var(--ink-2);
    max-width: 34rem;
  }

  .practice {
    display: grid;
    gap: 0.35rem;
    padding-top: 0.2rem;
  }

  .practice ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem 1.2rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .practice a {
    display: inline-flex;
    align-items: center;
    gap: 0.55em;
    min-height: 32px;
    font-weight: 600;
    text-decoration: none;
  }

  .name {
    text-decoration: underline;
    text-decoration-color: var(--accent);
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
  }

  .practice a:hover .name {
    text-decoration-thickness: 2px;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.9rem 1.4rem;
    margin-top: 0.5rem;
  }

  @media (min-width: 900px) {
    .project-card--row {
      grid-template-columns: minmax(0, 24rem) minmax(0, 1fr);
      gap: 2.6rem;
      align-items: start;
    }
  }
</style>
