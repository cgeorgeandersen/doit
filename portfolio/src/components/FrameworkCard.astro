---
/**
 * A framework as a method: its element tile and question, title, one-line
 * thesis, review stamp, and the projects and lab notes that apply it (derived,
 * never typed twice). The card wears its framework's color (a band on top, the tile), the
 * same color its projects carry.
 */
import ElementTile from './ElementTile.astro';
import ReviewStamp from './ReviewStamp.astro';
import { SITE } from '../config/site';
import type { FrameworkElement, Framework, Post, Project } from '../lib/content';

interface Props {
  framework: Framework;
  element: FrameworkElement;
  projects?: Project[];
  /** Lab notes that apply the framework, listed after the projects. */
  notes?: Post[];
  headingLevel?: 'h2' | 'h3';
  proofLabel?: string;
  /** Color slot from getSite().colorOf(). */
  color?: 0 | 1 | 2 | 3 | 4;
}

const { framework, element, projects = [], notes = [], headingLevel = 'h3', proofLabel = 'Applied in', color = 1 } = Astro.props;
const { title, thesis, question, lastReviewed, draft } = framework.data;
const Heading = headingLevel;
---

<article class="framework-card" data-fw={color}>
  <div class="fw-head">
    <ElementTile element={element} color={color} size="sm" />
    <div class="fw-head-text">
      {question && <p class="fw-kicker">{question}</p>}
      <Heading class="fw-title"><a class="quiet-link" href={`/frameworks/${framework.id}`}>{title}</a></Heading>
    </div>
  </div>
  <p class="fw-thesis">{thesis}</p>
  <p class="fw-stamp">
    <ReviewStamp date={lastReviewed} />
    {draft && <span class="draft">Draft · not published</span>}
  </p>
  {
    projects.length + notes.length > 0 && (
      <div class="fw-proof">
        <p class="label">{proofLabel}</p>
        <ul>
          {projects.map((p) => (
            <li>
              <a href={`/projects/${p.id}`}>
                {p.data.title} <span aria-hidden="true">→</span>
              </a>
            </li>
          ))}
          {notes.map((n) => (
            <li>
              <a href={`/writing/${n.id}`}>
                {n.data.title} <span aria-hidden="true">→</span>
              </a>
              <span class="kind">{SITE.sections.writing.item}</span>
            </li>
          ))}
        </ul>
      </div>
    )
  }
</article>

<style>
  .framework-card {
    display: grid;
    gap: 0.75rem;
    align-content: start;
    height: 100%;
    padding: 1.4rem 1.3rem 1.3rem;
    border: 1px solid var(--rule);
    border-radius: 16px;
    background: var(--paper);
    box-shadow: inset 0 5px 0 var(--fw);
  }

  .fw-head {
    display: flex;
    align-items: center;
    gap: 0.9rem;
  }

  .fw-head-text {
    display: grid;
    gap: 0.3rem;
    min-width: 0;
  }

  .fw-kicker {
    font-family: var(--font-label);
    font-size: var(--step--2);
    font-weight: 600;
    letter-spacing: 0.08em;
    line-height: 1.35;
    text-transform: uppercase;
    color: var(--ink-3);
  }

  .fw-title {
    font-family: var(--font-display);
    font-weight: 750;
    font-size: clamp(1.45rem, 2.4vw, 1.7rem);
    line-height: 1.1;
    letter-spacing: -0.03em;
  }

  .fw-thesis {
    color: var(--ink-2);
    line-height: 1.5;
  }

  .fw-stamp {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 0.9rem;
  }

  .draft {
    font-family: var(--font-label);
    font-size: 0.7rem;
    color: var(--stale-ink);
  }

  .fw-proof {
    display: grid;
    gap: 0.25rem;
    margin-top: 0.3rem;
    padding-top: 0.8rem;
    border-top: 1px solid var(--rule);
  }

  .fw-proof ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* Ordinary text flow, so a long title wraps with its arrow and keeps the space before it. */
  .fw-proof a {
    display: inline-block;
    padding-block: 0.3rem;
    font-weight: 600;
    line-height: 1.35;
  }

  .fw-proof li + li {
    margin-top: 0.2rem;
  }

  /* A lab note is marked as one, under its title, so it isn't mistaken for a project. */
  .kind {
    display: block;
    margin-top: -0.1rem;
    font-family: var(--font-label);
    font-size: 0.66rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-3);
  }
</style>
