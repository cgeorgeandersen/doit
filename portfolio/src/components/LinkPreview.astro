---
/**
 * The live site, previewed the way a link unfurls in a message: its image,
 * its domain, its title and description. The whole card opens the site.
 */
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import { domainOf } from '../lib/content';

interface Props {
  url: string;
  title: string;
  description: string;
  image?: ImageMetadata | undefined;
  imageAlt?: string | undefined;
}

const { url, title, description, image, imageAlt } = Astro.props;
---

<a class="preview" href={url} target="_blank" rel="noopener">
  {
    image && (
      <Image
        src={image}
        alt={imageAlt ?? ''}
        widths={[560, 800, 1100, 1400]}
        sizes="(min-width: 1100px) 30rem, calc(100vw - 32px)"
        loading="eager"
        fetchpriority="high"
      />
    )
  }
  <span class="meta">
    <span class="domain">{domainOf(url)} <span aria-hidden="true">↗</span></span>
    <span class="title">{title}</span>
    <span class="desc">{description}</span>
  </span>
  <span class="visually-hidden">(opens in a new tab)</span>
</a>

<style>
  .preview {
    display: block;
    overflow: hidden;
    border: 1px solid var(--rule-strong);
    border-radius: 6px;
    background: var(--paper-2);
    color: inherit;
    text-decoration: none;
    box-shadow: var(--shadow);
    transition: border-color 160ms var(--ease), transform 200ms var(--ease);
  }

  .preview:hover {
    border-color: var(--ink-3);
    transform: translateY(-2px);
  }

  .preview :global(img) {
    width: 100%;
    aspect-ratio: 1200 / 630;
    object-fit: cover;
    border-bottom: 1px solid var(--rule);
  }

  .meta {
    display: grid;
    gap: 0.2rem;
    padding: 0.85rem 1rem 1rem;
  }

  .domain {
    font-family: var(--font-mono);
    font-size: 0.64rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-3);
  }

  .title {
    font-weight: 650;
    line-height: 1.3;
  }

  .desc {
    font-size: 0.88rem;
    line-height: 1.45;
    color: var(--ink-2);
  }
</style>
