---
/**
 * Who did what on a lab note: Ideas · Writing · Final call, the three parts
 * of the Keep It Human framework. A list of terms and values, so screen
 * readers announce each pair.
 */
import { authorshipParts, type Authorship } from '../lib/authorship';

interface Props {
  authorship: Authorship;
}

const parts = authorshipParts(Astro.props.authorship);
---

<dl class="authorship">
  {
    parts.map(({ term, value }) => (
      <div>
        <dt>{term}</dt>
        <dd>{value}</dd>
      </div>
    ))
  }
</dl>

<style>
  .authorship {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.1rem;
    margin: 0;
    font-family: var(--font-label);
    font-size: 0.78rem;
    color: var(--ink-2);
  }

  .authorship div {
    display: inline-flex;
    gap: 0.5em;
    align-items: baseline;
  }

  dt {
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-3);
  }

  dd {
    margin: 0;
  }
</style>
