---
/**
 * The top bar: wordmark, main navigation (from site.ts) and the theme toggle.
 * On phones the navigation sits on its own row under the wordmark; five short
 * labels fit in that row at 320px (with tighter spacing on phones), so there
 * is no menu button to open. A sixth would need re-measuring.
 */
import { SITE } from '../config/site';
import ThemeToggle from './ThemeToggle.astro';

const path = Astro.url.pathname.replace(/\/+$/, '') || '/';

/** "page" on the section's own page, "true" anywhere inside it (e.g. a single project). */
function current(href: string): 'page' | 'true' | undefined {
  if (path === href) return 'page';
  if (path.startsWith(`${href}/`)) return 'true';
  return undefined;
}
---

<header class="site-header">
  <div class="bar wide">
    <a class="wordmark" href="/" aria-current={path === '/' ? 'page' : undefined}
      ><span class="dots" aria-hidden="true"><i data-fw="0"></i><i data-fw="1"></i><i data-fw="2"></i><i data-fw="3"></i></span>{SITE.name}</a
    >
    <nav aria-label="Main">
      <ul>
        {
          SITE.nav.map((item) => (
            <li>
              <a href={item.href} aria-current={current(item.href)}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <div class="tools">
      <ThemeToggle />
    </div>
  </div>
</header>

<style>
  .site-header {
    border-bottom: 1px solid var(--rule);
  }

  .bar {
    display: grid;
    grid-template-columns: 1fr auto;
    grid-template-areas:
      'brand tools'
      'nav nav';
    align-items: center;
    column-gap: 1rem;
    padding-top: 0.35rem;
  }

  .wordmark {
    grid-area: brand;
    justify-self: start;
    padding-block: 0.4rem;
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.05rem;
    letter-spacing: -0.02em;
    text-decoration: none;
    white-space: nowrap;
  }

  /* One dot per framework color: the site's mark. */
  .dots {
    display: inline-grid;
    grid-template-columns: repeat(2, 6px);
    gap: 3px;
  }

  .dots i {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--fw);
  }

  .tools {
    grid-area: tools;
  }

  nav {
    grid-area: nav;
    margin-inline: -0.45rem;
    border-top: 1px solid var(--rule);
  }

  ul {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  nav a {
    display: flex;
    align-items: center;
    min-height: 44px;
    padding: 0 0.45rem;
    font-family: var(--font-label);
    font-size: 0.86rem;
    font-weight: 500;
    text-decoration: none;
    color: var(--ink-2);
    white-space: nowrap;
  }

  nav a:hover {
    color: var(--ink);
  }

  nav a[aria-current] {
    color: var(--ink);
    box-shadow: inset 0 -2px 0 var(--accent);
  }

  /*
   * Phones and small tablets: tighter spacing keeps all five labels in one row
   * down to 320px, and every link stays at least 44px wide.
   */
  @media (max-width: 799px) {
    nav {
      margin-inline: -0.2rem;
    }

    nav a {
      justify-content: center;
      min-width: 44px;
      padding: 0 0.2rem;
    }
  }

  @media (max-width: 359px) {
    nav {
      margin-inline: -0.15rem;
    }

    nav a {
      padding: 0 0.15rem;
      font-size: 0.74rem;
    }
  }

  /* One row from 800px: below that, five labels beside the wordmark don't fit. */
  @media (min-width: 800px) {
    .bar {
      grid-template-columns: auto 1fr auto;
      grid-template-areas: 'brand nav tools';
      padding-top: 0;
    }

    nav {
      margin-inline: 0;
      border-top: 0;
    }

    ul {
      justify-content: flex-end;
      gap: 0.4rem;
    }

    nav a {
      min-height: 3.2rem;
    }
  }
</style>
