---
/** Lab notes, like a notebook: entry number, date, title, summary (when there is one) and review stamp. */
import ReviewStamp from './ReviewStamp.astro';
import { reviewedOn, type Post } from '../lib/content';
import { formatDate, isoDate } from '../lib/dates';

interface Props {
  posts: Post[];
  /** Entry numbers from getSite().entryOf(). */
  entryOf: (post: Post) => string;
  headingLevel?: 'h2' | 'h3';
  compact?: boolean;
}

const { posts, entryOf, headingLevel = 'h2', compact = false } = Astro.props;
const Heading = headingLevel;
---

<ol class:list={['posts', { compact }]}>
  {
    posts.map((post) => (
      <li>
        <article class="post">
          <p class="date">
            <span class="entry">Entry {entryOf(post)}</span>
            <time datetime={isoDate(post.data.date)}>{formatDate(post.data.date)}</time>
            {post.data.draft && <span class="draft">Draft · not published</span>}
          </p>
          <div class="text">
            <Heading class="title">
              <a class="quiet-link" href={`/writing/${post.id}`}>
                {post.data.title}
              </a>
            </Heading>
            {!compact && post.data.summary && <p class="summary">{post.data.summary}</p>}
            {!compact && (
              <p class="stamp-row">
                <ReviewStamp date={reviewedOn(post)} />
              </p>
            )}
          </div>
        </article>
      </li>
    ))
  }
</ol>

<style>
  .posts {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .posts > li + li {
    border-top: 1px solid var(--rule);
  }

  .post {
    display: grid;
    gap: 0.4rem 2rem;
    padding-block: 1.4rem;
  }

  .date {
    display: flex;
    flex-wrap: wrap;
    gap: 0.1rem 0.8rem;
    align-content: start;
    font-family: var(--font-label);
    font-size: 0.74rem;
    letter-spacing: 0.04em;
    color: var(--ink-3);
    padding-top: 0.35rem;
    font-variant-numeric: tabular-nums;
  }

  .entry {
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink);
  }

  @media (min-width: 720px) {
    .date {
      flex-direction: column;
    }
  }

  .draft {
    color: var(--stale-ink);
  }

  .text {
    display: grid;
    gap: 0.5rem;
  }

  .title {
    font-family: var(--font-display);
    font-weight: 750;
    font-size: clamp(1.45rem, 2.8vw, 1.8rem);
    line-height: 1.1;
  }

  .compact .title {
    font-size: 1.35rem;
  }

  .summary {
    color: var(--ink-2);
    max-width: 38rem;
  }

  @media (min-width: 720px) {
    .post {
      grid-template-columns: 9rem minmax(0, 1fr);
    }
  }
</style>
