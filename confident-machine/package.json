{
  "name": "the-confident-machine",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "An interactive essay on calibrated trust: how to live and work with AI that is fluent, confident, and sometimes wrong.",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "corpus": "node scripts/prepare-corpus.mjs",
    "check:facts": "node scripts/check-timely.mjs",
    "fonts": "node scripts/copy-fonts.mjs"
  },
  "engines": {
    "node": "22.x"
  },
  "dependencies": {
    "d3-scale": "^4.0.2",
    "d3-shape": "^3.2.0"
  },
  "devDependencies": {
    "@fontsource-variable/bodoni-moda": "^5.3.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@types/d3-scale": "^4.0.9",
    "@types/d3-shape": "^3.2.0",
    "@types/node": "^26.6.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
